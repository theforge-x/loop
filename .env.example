NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Lagos
# Server-only; not required until the corresponding later phases.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_FROM_EMAIL=
# Optional; defaults to a server-key HMAC for local request limits.
RATE_LIMIT_SECRET=
# Enable only when a trusted proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
RESEND_API_KEY=
PAYSTACK_TEST_EMAIL=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_WEBHOOK_PREVIOUS_SECRET=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Verified Resend delivery events (Svix signing secret).
RESEND_WEBHOOK_SECRET=
# At least 32 random characters; authenticates the scheduled notification worker.
CRON_SECRET=
