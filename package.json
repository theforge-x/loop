{
  "name": "loop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:types": "node scripts/generate-database-types.mjs",
    "verify:connection": "node --env-file=.env.local scripts/verify-connection.mjs",
    "test:database": "node --env-file=.env.local --test --test-concurrency=1 tests/database/platform.test.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed-development.mjs",
    "test:public": "node --env-file=.env.local --test tests/database/public-routes.test.mjs",
    "test:invitations": "node --experimental-strip-types --env-file=.env.local --test tests/workflows/invitations.test.mjs",
    "test:payments": "node --experimental-strip-types --test tests/payments/*.test.mjs",
    "verify:paystack": "node --experimental-strip-types --env-file=.env.local scripts/verify-paystack.mjs",
    "test:administration": "node --env-file=.env.local --test tests/workflows/administration.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "framer-motion": "^14.9.1",
    "json-bigint": "^1.0.0",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  }
}
