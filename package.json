{
  "name": "loop-wedding",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "test:integration": "prisma generate && tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
